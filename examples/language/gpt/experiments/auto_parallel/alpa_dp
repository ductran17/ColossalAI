  all_possible_stage_costs = np.sort(np.unique(compute_cost))  # line 110
                                                                                                                                                                                                                                                                                                   
  for max_stage_cost in all_possible_stage_costs:                                                                                                                                                                                                                                                  
      if max_stage_cost * num_microbatches >= best_cost:   # pruning
          break                                                                                                                                                                                                                                                                                    
      cost, solution = alpa_dp_impl(...)
