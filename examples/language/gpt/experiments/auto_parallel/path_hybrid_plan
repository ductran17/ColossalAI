  from colossalai.auto_parallel.hybrid_planner import auto_plan, profile_cluster
                                                                                                                                                                                                                                                                   
  # Phase 1: profile (runs on all ranks, ~5 seconds)
  # Measures: α/β (intra + cross) + T_block (isolated) + T_block_repr (with M activations)
  model_cfg_dict = {"batch": 2, "seq": 64, "hidden": 256, "heads": 4}
  comm_profile = profile_cluster(
      model_cfg=model_cfg_dict,
      warmup=3, repeat=10,
      num_microbatches=4,  # actual M from training config
  )

  # Phase 2: plan (rank 0 computes, result is deterministic because
  #          comm_profile is already all-reduced in profile_cluster)
  pp, tp, dp = auto_plan(
      model_cfg={"layers": 8, "hidden": 1024, "heads": 16, "seq": 2048, "batch": 2},
      world_size=world_size,
      node_gpus=[2, 4, 2],          # your cluster topology
      profile=comm_profile,         # ClusterProfile object
      topology=classify_comms([2,4,2], pp, tp, dp),
      num_microbatches=4,
  )
                  
  # Phase 3: train with the auto-selected plan                                                                                                                                                                                                                     
  plugin = HybridParallelPlugin(pp_size=pp, tp_size=tp, num_microbatches=4)
                                                                                                                                                                                                                                                                   
