  Step 3 — cost_model.py (analytical formula)
                                                                                                                                                                                                                                                                   
  def estimate_step_time(model_cfg, pp, tp, dp, comm_profile, topology):
      """
      model_cfg: {layers, hidden, heads, seq, batch, param_bytes_per_layer}
      comm_profile: ClusterProfile with α_intra, β_intra, α_cross, β_cross,
                    T_block (isolated), T_block_repr (with M activations)
      topology: output of classify_comms()
      Returns: estimated seconds per training step
      """
      # ── Compute ────────────────────────────────────────────────
      # layers_per_stage = layers / pp
      # Conditional T_block: isolated for pp=1, representative for pp>1
      t_block_eff = comm_profile.T_block if pp == 1 else comm_profile.T_block_repr
      T_compute = (layers / pp) * (t_block_eff / tp) * num_microbatches

      # ── Pipeline bubble ────────────────────────────────────────
      # 1F1B schedule bubble fraction: (pp-1) / (num_microbatches + pp - 1)
      T_bubble = ((pp - 1) / (num_microbatches + pp - 1)) * T_compute if pp > 1 else 0

      # ── TP AllReduce (2 per layer: attention + MLP) ────────────
      # AllReduce size: batch × seq × hidden × dtype_bytes
      # Ring AllReduce cost: 2 × (tp-1)/tp × (α + β × size)
      α, β = intra if topology.tp_is_intra else cross
      T_tp = (layers / pp) * 2 * ring_allreduce_cost(act_size, tp, α, β) * num_microbatches

      # ── DP gradient AllReduce (partially overlapped) ─────────────
      # Param size per GPU: total_params / pp / tp
      # Overlap depends on topology: 70% hidden intra-node, 30% hidden cross-node
      α, β = cross if topology.dp_is_cross else intra
      raw_ar = ring_allreduce_cost(param_size / pp / tp, dp, α, β)
      overlap_factor = 1.0 - min(1, T_compute / raw_ar) * (0.7 if intra else 0.3)
      T_dp = overlap_factor * raw_ar if dp > 1 else 0

      # ── PP P2P send/recv at stage boundaries ──────────────────
      # One send per microbatch, pipeline-pipelined with compute
      α, β = cross if topology.pp_is_cross else intra
      T_pp_p2p = num_microbatches * p2p_cost(act_size, α, β) if pp > 1 else 0

      # ── Step overhead (embedding + LM head + loss) ─────────────
      # Runs once per step, scaled proportionally to T_block
      T_step = step_overhead(model_cfg, comm_profile.T_block)

      # ── Execution overhead (AdamW + NCCL + dispatch) ───────────
      # Four physically based components with GPU-specific coefficients
      T_exec = execution_overhead(model_cfg, pp, tp, dp, comm_profile, num_microbatches)

      return T_compute + T_bubble + T_tp + T_dp + T_pp_p2p + T_step + T_exec
                                                                                                                                                                                                                                                                   
