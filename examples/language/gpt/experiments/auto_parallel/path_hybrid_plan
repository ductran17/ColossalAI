  Step 4 — search.py (enumerate + score)
                                                                                                                                                                                                                                                                   
  def auto_plan(model_cfg, world_size, node_gpus, comm_profile,
                num_microbatches=4, memory_budget_gb=None):                                                                                                                                                                                                        
      """                                                                                                                                                                                                                                                          
      Returns best (pp, tp, dp) for the given cluster and model.                                                                                                                                                                                                   
      """                                                                                                                                                                                                                                                          
      candidates = [
          (pp, tp, dp)                                                                                                                                                                                                                                             
          for pp in range(1, world_size+1)
          for tp in range(1, world_size+1)
          for dp in range(1, world_size+1)                                                                                                                                                                                                                         
          if pp * tp * dp == world_size
      ]                                                                                                                                                                                                                                                            
                  
      best, best_cost = None, float('inf')                                                                                                                                                                                                                         
      for pp, tp, dp in candidates:
          # Prune: tp > min GPUs per node → always cross-node TP (very expensive)                                                                                                                                                                                  
          if tp > min(node_gpus):                                                                                                                                                                                                                                  
              continue
          # Prune: pp > num_layers (can't split fewer layers than stages)                                                                                                                                                                                          
          if pp > model_cfg['layers']:                                                                                                                                                                                                                             
              continue                                                                                                                                                                                                                                             
          # Prune: memory check — model must fit on each GPU                                                                                                                                                                                                       
          if memory_budget_gb and not fits_in_memory(model_cfg, pp, tp, memory_budget_gb):                                                                                                                                                                         
              continue
                                                                                                                                                                                                                                                                   
          topology = classify_comms(node_gpus, pp, tp, dp)
          cost = estimate_step_time(model_cfg, pp, tp, dp, comm_profile, topology, num_microbatches)                                                                                                                                                               
          if cost < best_cost:                                                                                                                                                                                                                                     
              best_cost, best = cost, (pp, tp, dp)
                                                                                                                                                                                                                                                                   
      return best, best_cost

  The pruning rules encode domain knowledge without full ILP:                                                                                                                                                                                                      
  - TP cross-node is very expensive (AllReduce per layer over Ethernet) → never use tp > min_gpus_per_node
  - PP > layers is invalid → each stage must have ≥1 layer                                                                                                                                                                                                         
  - Memory budget → model shard must fit on one GPU       
                                                                                                                                                                                                                                                                   
  For your 8-GPU cluster this leaves at most ~5 candidates to score rather than 10.                                                                                                                                                                                
                                                                                                                                                                                                                                                                   
