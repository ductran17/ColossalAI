  def alpa_dp(num_layers, num_devices, num_microbatches,
              submesh_choices, num_autosharding_configs, compute_cost):                                                                                                                                                                                                                            
                                                                                                                                                                                                                                                                                                   
  Takes the cost table from Sub-step B and finds the globally cheapest pipeline partition.                                                                                                                                                                                                         
                                                                                                                                                                                                                                                                                                   
