  5. Full cost formula                                                                                                                                                                                                                                             
                  
  T_step(pp, tp, dp) =

    # Compute (dominant term for small clusters)                                                                                                                                                                                                                   
    (num_layers/pp) × T_block / tp
                                                                                                                                                                                                                                                                   
    # Pipeline bubble                                                                                                                                                                                                                                              
  + (pp-1)/num_microbatches × (num_layers/pp) × T_block / tp
                                                                                                                                                                                                                                                                   
    # TP AllReduce (2 per block, intra-node if tp ≤ node_gpus_min)                                                                                                                                                                                                 
  + (num_layers/pp) × 2 × ring_allreduce(B×S×H×4, tp, α_tp, β_tp)
                                                                                                                                                                                                                                                                   
    # PP P2P at stage boundaries (cross-node almost always)                                                                                                                                                                                                        
  + (pp-1) × p2p(B×S×H×4, α_pp, β_pp)                                                                                                                                                                                                                              
                                                                                                                                                                                                                                                                   
    # DP gradient sync (30% effective, overlapped with backward)
  + 0.3 × ring_allreduce(param_bytes/pp/tp, dp, α_dp, β_dp)                                                                                                                                                                                                        
                                                                                                                                                                                                                                                                   
  Where α_tp, β_tp are intra-node values if tp ≤ min_gpus_per_node, else cross-node.                                                                                                                                                                               
                                                                                                                                                                                                                                                                   
